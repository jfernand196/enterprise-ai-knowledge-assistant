# extractive runs without a key; gemini uses the Flash chain, then Groq, then extractive
LLM_PROVIDER=gemini
MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# local writes JSON under data/lakehouse; databricks reads the gold table through the Databricks CLI
LAKEHOUSE_BACKEND=databricks
DATABRICKS_PROFILE=your-cli-profile
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CATALOG=knowledge_assistant
