# extractive runs without a key; gemini uses the Flash chain, then Groq, then extractive
LLM_PROVIDER=gemini
MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# native uses the hand-written RAG and agent; langchain uses backend/app/lc; langgraph uses backend/app/lg
# All three share the same index, tools, and authorization.
ORCHESTRATOR=native

# LLMOps history defaults to data/llmops/*.jsonl (gitignored). Set to empty to keep it in memory only.
# Traces store the user's question: treat the file as sensitive.
# TRACES_PATH=
# EVALUATIONS_PATH=

# local writes JSON under data/lakehouse; databricks reads the gold table through the Databricks CLI
LAKEHOUSE_BACKEND=databricks
DATABRICKS_PROFILE=your-cli-profile
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CATALOG=knowledge_assistant
